# ========================================================
# TuitionPro Environment Variables Template
# Copy this to .env (do NOT commit .env to Git)
# ========================================================

# Generate a strong key for production (e.g. from https://djecrety.ir)
DJANGO_SECRET_KEY=your-production-secret-key-here

# False for production, True for local development
DJANGO_DEBUG=False

# Comma-separated domains where your app will run:
# For Render: tuitionpro.onrender.com
# For PythonAnywhere: yourusername.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=.onrender.com,.pythonanywhere.com,localhost,127.0.0.1

# CSRF Trusted origins (required for HTTPS POST requests on production)
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.pythonanywhere.com,http://127.0.0.1,http://localhost
